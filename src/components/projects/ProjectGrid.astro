---
import type { ProjectEntry } from '@lib/projects';
import ProjectCard from './ProjectCard.astro';

export type Props = {
  projects: readonly ProjectEntry[];
};

const { projects } = Astro.props;
---

<div class="mb-8 grid grid-cols-1 gap-x-16 gap-y-16 lg:grid-cols-2">
  {
    projects.map(({ id, data: { title, description, image, linkText } }) => (
      <ProjectCard
        title={title}
        description={description}
        image={image}
        href={`/projects/${id}`}
        linkText={linkText}
      />
    ))
  }
</div>
