{
  "name": "astro-portfolio",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:fast": "node ./node_modules/typescript-native/bin/tsc --noEmit",
    "format": "oxfmt . && prettier --write \"**/*.astro\"",
    "format:check": "oxfmt --check . && prettier --check \"**/*.astro\"",
    "lint": "oxlint"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@fontsource/overpass": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "satteri": "^0.10.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
