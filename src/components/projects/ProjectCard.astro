---
import Icon from '@components/Icon.astro';

export type Props = {
  title: string;
  description: string;
  image: string;
  href: string;
  linkText?: string;
};

const {
  title,
  description,
  image,
  href,
  linkText = 'View project',
} = Astro.props;
---

<article
  class="group relative mt-4 flex min-h-full cursor-pointer flex-col lg:max-w-lg"
>
  <div
    style={{ backgroundImage: `url(${image})` }}
    class="h-72 rounded-t-xl rounded-b bg-cover bg-top transition-transform duration-[250ms] group-hover:scale-[1.02] group-focus:scale-[1.02]"
  >
  </div>

  <h3 class="mt-4 text-secondary">{title}</h3>

  <p class="mt-4 !mb-0">{description}</p>
  <p class="mt-4 !mb-0 inline-flex items-center text-secondary uppercase">
    <a {href} aria-label={`Read more about ${title}`} class="no-underline">
      {linkText}
    </a>
    <Icon name="chevronRight" size={16} />
  </p>
</article>

<style>
  /* Make the entire card clickable */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
</style>
